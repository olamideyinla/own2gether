# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/own2gether"

# Vercel Blob — read/write token for KYC document storage.
# In Vercel: add via Storage → Blob → your store → .env.local
# Locally: copy BLOB_READ_WRITE_TOKEN from your Vercel project's .env.local
BLOB_READ_WRITE_TOKEN=""

# Admin dashboard password (any string; set in Vercel env vars for production)
ADMIN_PASSWORD="change-me"

# Vercel Cron secret — Vercel injects this automatically in production.
# Set it manually in your Vercel project's environment variables.
CRON_SECRET=""

# Resend API key — for subscriber notification emails.
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=""

# Sender address for notification emails (must be a verified domain in Resend).
FROM_EMAIL="Own2gether <notifications@own2gether.com>"
